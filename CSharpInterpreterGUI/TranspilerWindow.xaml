<Window x:Class="CSharpInterpreterGUI.TranspilerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transpiler" Height="400" Width="600" Background="#F0F4F8">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Interpreter Code" FontWeight="Bold" Margin="5" Grid.Row="0"/>
        <TextBox x:Name="InterpreterCodeBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                 BorderBrush="#AAAAAA" BorderThickness="1" Background="White" Grid.Row="1" />

        <TextBlock Text="Generated Python Code" FontWeight="Bold" Margin="5,10,5,5" Grid.Row="2"/>
        <TextBox x:Name="PythonCodeBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                 BorderBrush="#AAAAAA" BorderThickness="1" Background="White" IsReadOnly="True" Grid.Row="3" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" Grid.Row="4">
            <Button Content="Compile" Width="100" Margin="10" Click="CompileButton_Click"/>
            <Button Content="Run" Width="100" Margin="10" Click="RunButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
