<Window x:Class="CSharpInterpreterGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Math Interpreter" Height="700" Width="850" Background="#F0F4F8">


    <!-- Define Resource Styles -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <!-- Button Styles -->
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="2" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1948A" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#999999" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#7F7F7F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#FFB74D" />
        </Style>

        <Style x:Key="EqualButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SciButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#BBDEFB" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ClearButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#FFCDD2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ModeButton" TargetType="Button">

            <!-- Hover and Click Effects -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7986CB" />
                    <Setter Property="BorderBrush" Value="#3F51B5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5C6BC0" />
                    <Setter Property="BorderBrush" Value="#3949AB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid Margin="0,10,10,10">
        <!-- Main Grid Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="199*"/>
            <ColumnDefinition Width="295*"/>
            <ColumnDefinition Width="346*"/>
        </Grid.ColumnDefinitions>

        <!-- Top Toolbar -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="95,0,0,10" Width="490">
            <Button Content="New" Width="60" Margin="0,0,10,0" Style="{StaticResource CalcButton}" Click="Button_Click"/>
            <Button Content="Open" Width="60" Margin="0,0,10,0" Style="{StaticResource CalcButton}" Click="Button_Click"/>
            <Button Content="Save" Width="60" Margin="0,0,10,0" Style="{StaticResource CalcButton}" Click="Button_Click"/>
            <Button Content="Diff" Width="60" Margin="0,0,10,0" Style="{StaticResource CalcButton}" />
            <Button Content="Min" Width="60" Margin="0,0,10,0" Background="LightGreen" Style="{StaticResource CalcButton}" Click="Button_Click"/>
            <Button Content="Max" Width="60" Margin="0,0,10,0" Background="Yellow" Style="{StaticResource CalcButton}" Click="Button_Click"/>
            <Button Content="Close" Width="60" Margin="0,0,10,0" Background="Red" Style="{StaticResource CalcButton}" Click="Button_Click"/>
        </StackPanel>



        <!-- Workspace Text Input Box -->
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" Height="40">
            <!-- Reduced Width TextBox -->
            <TextBox x:Name="displayTextBox" Width="470" Text=">>" VerticalAlignment="Center" Margin="0,0,10,0" Height="30"
             TextChanged="DisplayTextBox_TextChanged" SelectionChanged="DisplayTextBox_SelectionChanged" />

            <!-- Buttons aligned to the right of the TextBox -->
            <Button Content="Evaluate" Width="60" Height="30" Background="LightGreen" FontWeight="Bold" Style="{StaticResource CalcButton}" Margin="5,0,0,0" VerticalAlignment="Center" Click="Evaluate_Click"/>
            <Button Content="Clear" Width="60" Height="30" Background="Coral" FontWeight="Bold" Style="{StaticResource CalcButton}" Margin="5,0,0,0" VerticalAlignment="Center" Click="Clear_Click"/>
        </StackPanel>


        <!-- Functions/Variables, Workspace, and Graph Section -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="199*"/>
                <!-- Functions Section -->
                <ColumnDefinition Width="248*"/>
                <!-- Workspace Section -->
                <ColumnDefinition Width="393*"/>
                <!-- Graph Section -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- All sections proportionally resize -->
            </Grid.RowDefinitions>

            <StackPanel Margin="4,10,16,0">
                <!-- Toggle Mode Button -->
                <Button x:Name="ModeButton"
            Content="Scientific"
            Click="ToggleMode_Click"
            Style="{StaticResource CalcButton}"
            Background="AntiqueWhite"
            Foreground="SlateGray"
            FontSize="15"
            Padding="10,4"
            Width="100"
            Height="30"
            FontFamily="Roboto Slab"
            FontWeight="Bold"
            Cursor="Hand"
            HorizontalAlignment="Left"
            Margin="0,0,0,10" />

                <!-- Standard Calculator Buttons -->
                <StackPanel Margin="0,10,0,10" Height="93">

                    <UniformGrid Rows="4" Columns="5" Height="111">
                        <Button Content="5" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="6" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="7" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="8" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="9" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="4" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="3" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="2" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="1" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="0" Style="{StaticResource CalcButton}" Click="Button_Click"/>
                        <Button Content="÷" Style="{StaticResource OpButton}" Tag="/" Click="Button_Click"/>
                        <Button Content="×" Style="{StaticResource OpButton}" Tag="*" Click="Button_Click"/>
                        <Button Content="-" Style="{StaticResource OpButton}" Click="Button_Click"/>
                        <Button Content="+" Style="{StaticResource OpButton}" Click="Button_Click"/>
                        <Button Content="." Style="{StaticResource CalcButton}" Click="Button_Click"/>
                    </UniformGrid>
                </StackPanel>

                <!-- Scientific Calculator Buttons -->
                <StackPanel x:Name="scientificPanel" Visibility="Collapsed" Margin="0,10,0,0">

                    <UniformGrid Rows="3" Columns="5">
                        <Button Content="sin" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                        <Button Content="cos" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                        <Button Content="tan" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                        <Button Content="ln" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                        <Button Content="log" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                        <Button Content="√" Style="{StaticResource SciButton}" Tag="sqrt" Click="ScientificButton_Click" />
                        <Button Content="x²" Style="{StaticResource SciButton}" Tag="^2" Click="ScientificButton_Click" />
                        <Button Content="e^x" Style="{StaticResource SciButton}" Tag="exp" Click="ScientificButton_Click" />
                        <Button Content="π" Style="{StaticResource SciButton}" Tag="pi" Click="ScientificButton_Click" />
                        <Button Content="e" Style="{StaticResource SciButton}" Tag="e" Click="ScientificButton_Click" />
                        <Button Content="(" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                        <Button Content=")" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                        <Button Content="∫" Style="{StaticResource SciButton}" Tag="integrate" Click="ScientificButton_Click" />
                        <Button Content="d/dx" Style="{StaticResource SciButton}" Tag="differentiate" Click="ScientificButton_Click" />
                        <Button Content="i" Style="{StaticResource SciButton}" Tag="i" Click="ScientificButton_Click" />
                    </UniformGrid>
                </StackPanel>




                <StackPanel Margin="10,10,10,0" Grid.Column="0">
                    <TextBlock Text="Variables" FontWeight="Bold" Margin="0,10,0,10"/>
                    <Button Content="Reset" Width="50" Click="Button_Click_1" Margin="120,-35,-20,0" Height="20"/>
                    <Grid Margin="0,0,0,0" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Padding="10" Background="#FFFFFF" Margin="0,0,-16,-322">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="VariableContainer">
                                    <TextBlock Text="(No variables defined)" FontStyle="Italic" Foreground="Gray"/>
                                    <TextBox x:Name="variablesTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="285"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Workspace Section -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,24,10,-4">
                <TextBlock Text="Workspace" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Clear" Width="50" Click="ClearHistory_Click" Margin="150,-35,-20,0" Height="20"/>
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Background="#FFFFFF" Height="511">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="workspaceHistoryBox" Text=">>" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Graph Section -->
            <StackPanel Grid.Column="2" Margin="10,22,0,-22">
                <TextBlock Text="Graphs" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Background="White" Height="517">
                    <StackPanel Orientation="Vertical">
                        <Grid Margin="0,0,0,10" Height="154">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Content="New" Width="70"/>
                                <Button Content="Save" Width="70"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="X Min:" Width="50"/>
                                <TextBox x:Name="XMinTextBox" Width="60" Text=""/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="X Max:" Width="50"/>
                                <TextBox x:Name="XMaxTextBox" Width="60" Text=""/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="X Step:" Width="50"/>
                                <TextBox x:Name="XStepTextBox" Width="60" Text=""/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <Button Content="d/dx" Width="100" Margin="0,0,10,0" Click="Differential_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                <Button Content="Find Root" Width="100" Margin="0,0,10,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                <Button Content="Definite Integral" Width="100" Margin="0,0,10,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Margin="0,0,0,10">
                                <Button Content="Update" Width="100" Margin="0,0,10,0" Click="UpdateButton_Click"/>
                            </StackPanel>
                            <ComboBox x:Name="PlotTypeComboBox" Width="120" Height="25" SelectionChanged="PlotTypeComboBox_SelectionChanged"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Padding="5" Background="#F0F0F0" BorderBrush="#BBBBBB" BorderThickness="1" Margin="-1,-10,0,0">
                                <ComboBoxItem Content="Select Plot Type" IsSelected="True"/>
                                <ComboBoxItem Content="Plot Graph" FontWeight="Bold"/>
                                <ComboBoxItem Content="Linear Plot" FontWeight="Bold"/>
                                <ComboBoxItem Content="Spline Plot" FontWeight="Bold"/>
                            </ComboBox>
                        </Grid>
                        <Border BorderBrush="Black" BorderThickness="1" Background="White" Height="328">
                            <Grid>
                                <!-- PlotView takes up the full space of the grid -->
                                <oxy:PlotView x:Name="plotView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                <!-- Expand Button in the top-right corner -->
                                <Button x:Name="ExpandButton" Content="↗" HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="30" Height="30" Margin="0,5,5,0" Background="LightGray" Click="ExpandButton_Click" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
