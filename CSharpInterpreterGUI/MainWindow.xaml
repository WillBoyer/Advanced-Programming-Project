<Window x:Class="CSharpInterpreterGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interpreter" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <!-- Define Resource Styles -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <!-- Button Styles -->
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1948A" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#999999" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#7F7F7F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#FFB74D" />
        </Style>

        <Style x:Key="EqualButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SciButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#BBDEFB" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ClearButton" BasedOn="{StaticResource CalcButton}" TargetType="Button">
            <Setter Property="Background" Value="#FFCDD2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ModeButton" TargetType="Button">

            <!-- Hover and Click Effects -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7986CB" />
                    <Setter Property="BorderBrush" Value="#3F51B5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5C6BC0" />
                    <Setter Property="BorderBrush" Value="#3949AB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Button Bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Help Button -->
            <Button x:Name="HelpButton"
                Content="Help"
                Click="HelpButton_Click"
                Style="{StaticResource CalcButton}"
                Background="LightSkyBlue"
                Foreground="Black"
                FontSize="15"
                Padding="10,4"
                Width="80"
                Height="30"
                FontFamily="Roboto Slab"
                FontWeight="Bold"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Grid.Column="0" />

            <!-- Mode Button -->
            <Button x:Name="ModeButton"
                Content="Scientific"
                Click="ToggleMode_Click"
                Style="{StaticResource CalcButton}"
                Background="AntiqueWhite"
                Foreground="SlateGray"
                FontSize="15"
                Padding="10,4"
                Width="100"
                Height="30"
                FontFamily="Roboto Slab"
                FontWeight="Bold"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Grid.Column="2" />
        </Grid>
       

        <!-- Plot Dropdown Menu (ComboBox) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" Grid.Row="0" Name="PlotButtonsPanel" Visibility="Collapsed">
            <!-- ComboBox for Plot Type Selection -->
            <ComboBox Name="PlotTypeComboBox" Width="120" Height="30" SelectionChanged="PlotTypeComboBox_SelectionChanged"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Margin="10" Padding="5" Background="#F0F0F0" BorderBrush="#BBBBBB" BorderThickness="1">
                <ComboBoxItem Content="Select Plot Type" IsSelected="True"/> 
                <ComboBoxItem Content="Plot Graph" FontWeight="Bold"/>
                <ComboBoxItem Content="Linear Plot" FontWeight="Bold"/>
                <ComboBoxItem Content="Spline Plot" FontWeight="Bold"/>
            </ComboBox>
        </StackPanel>

        <!-- Container for Split Display -->
        <Grid Grid.Row="1" Margin="10" Height="100" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Input TextBox -->
            <TextBox Name="displayTextBox" 
             Grid.Row="0" 
             FontSize="20" 
             IsReadOnly="False"
             TextAlignment="Right" 
             Background="#FFFFFF" 
             BorderBrush="#AAAAAA" 
             BorderThickness="1"
             TextWrapping="Wrap"
             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Result TextBox (Read-Only) -->
            <TextBox Name="resultTextBox" 
             Grid.Row="1" 
             FontSize="20" 
             IsReadOnly="True"
             TextAlignment="Right" 
             Background="#F0F0F0" 
             BorderBrush="#AAAAAA" 
             BorderThickness="1"
             Text="{Binding Output}" />
        </Grid>


        <!-- Standard Calculator Buttons -->
        <UniformGrid Grid.Row="2" Rows="5" Columns="4" Margin="10,5,10,5">
            <!-- Basic Operators -->
            <Button Content="7" Style="{StaticResource CalcButton}" Click="Button_Click"/>
            <Button Content="8" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="9" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="÷" Style="{StaticResource OpButton}" Tag="/" Click="Button_Click" />
            <Button Content="4" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="5" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="6" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="×" Style="{StaticResource OpButton}" Tag="*" Click="Button_Click" />

            <Button Content="1" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="2" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="3" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="-" Style="{StaticResource OpButton}" Click="Button_Click" />

            <Button Content="0" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="." Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="=" Style="{StaticResource CalcButton}" Click="Button_Click" />
            <Button Content="+" Style="{StaticResource OpButton}" Click="Button_Click" />
            <Button Content="C" Style="{StaticResource ClearButton}" Click="Clear_Click" />
            <Button Content="⌫" Style="{StaticResource ClearButton}" Click="Backspace_Click" />
            <Button Content="Evaluate" Style="{StaticResource CalcButton}" Click="Evaluate_Click" Background="ForestGreen" Foreground="White" FontWeight="Bold" />
        </UniformGrid>

        <!-- Scientific Panel -->
        <StackPanel Grid.Row="3" Margin="10" Visibility="Collapsed" Name="scientificPanel">
            <UniformGrid Rows="3" Columns="5">
                <Button Content="sin" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                <Button Content="cos" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                <Button Content="tan" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                <Button Content="ln" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                <Button Content="log" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />

                <Button Content="√" Style="{StaticResource SciButton}" Tag="sqrt" Click="ScientificButton_Click" />
                <Button Content="x²" Style="{StaticResource SciButton}" Tag="^2" Click="ScientificButton_Click" />
                <Button Content="e^x" Style="{StaticResource SciButton}" Tag="exp" Click="ScientificButton_Click" />
                <Button Content="π" Style="{StaticResource SciButton}" Tag="pi" Click="ScientificButton_Click" />
                <Button Content="e" Style="{StaticResource SciButton}" Tag="e" Click="ScientificButton_Click" />

                <Button Content="(" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                <Button Content=")" Style="{StaticResource SciButton}" Click="ScientificButton_Click" />
                <Button Content="∫" Style="{StaticResource SciButton}" Tag="integrate" Click="ScientificButton_Click" />
                <Button Content="d/dx" Style="{StaticResource SciButton}" Tag="differentiate" Click="ScientificButton_Click" />
                <Button Content="i" Style="{StaticResource SciButton}" Tag="i" Click="ScientificButton_Click" />

               
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
