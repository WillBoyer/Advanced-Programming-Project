<Window x:Class="CSharpInterpreterGUI.IntegralInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Integral Input" Height="200" Width="300">
    <StackPanel Margin="10">
        <Label Content="Lower Bound:" />
        <TextBox x:Name="LowerInput" Margin="0,5" />

        <Label Content="Upper Bound:" />
        <TextBox x:Name="UpperInput" Margin="0,5" />

        <Label Content="Interval:" />
        <TextBox x:Name="IntervalInput" Margin="0,5" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Margin="5" Click="OK_Click" />
            <Button Content="Cancel" Width="75" Margin="5" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
