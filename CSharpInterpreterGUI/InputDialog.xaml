<Window x:Class="CSharpInterpreterGUI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter For Loop Expression" Height="150" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Enter the for-loop expression:" VerticalAlignment="Top" Margin="10"/>
        <TextBox Name="loopInputTextBox" Width="300" Height="25" Margin="10,30,10,10"/>
        <Button Content="OK" Width="100" Height="30" HorizontalAlignment="Right" Margin="0,60,10,10" Click="OKButton_Click"/>
    </Grid>
</Window>
