<Window x:Class="CSharpInterpreterGUI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter For Loop Expression" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="For Loop Expression" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        </StackPanel>

        <!-- Start X Section -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5">
            <TextBlock Text="Start Value (x):" VerticalAlignment="Center" Width="120" FontSize="14"/>
            <TextBox Name="startXTextBox" Width="150" Height="30" FontSize="14" Margin="10,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- End X Section -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5">
            <TextBlock Text="End Value (x):" VerticalAlignment="Center" Width="120" FontSize="14"/>
            <TextBox Name="endXTextBox" Width="150" Height="30" FontSize="14" Margin="10,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Step X Section -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5">
            <TextBlock Text="Step Value:" VerticalAlignment="Center" Width="120" FontSize="14"/>
            <TextBox Name="stepXTextBox" Width="150" Height="30" FontSize="14" Margin="10,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- OK Button Section -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10">
            <Button Content="OK" Width="100" Height="30" FontSize="14" FontWeight="Bold" 
                    Background="#4CAF50" Foreground="White" BorderBrush="#388E3C" BorderThickness="1" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="OKButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
